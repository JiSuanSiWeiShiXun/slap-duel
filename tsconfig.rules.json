{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "game/assets/scripts",
    "outDir": ".test-build",
    "lib": ["ES2020"]
  },
  "include": ["game/assets/scripts/core/**/*.ts", "game/assets/scripts/session/**/*.ts", "game/assets/scripts/InputBridge.ts", "game/assets/scripts/InputObservation.ts", "game/assets/scripts/ActiveSessionClock.ts", "game/assets/scripts/RuntimeClock.ts", "game/assets/scripts/Feedback.ts", "game/assets/scripts/ParryMotion.ts", "game/assets/scripts/CharacterTimeline.ts", "game/assets/scripts/Cast.ts", "game/assets/scripts/GameLayout.ts"]
}
